# FinTrust Alert backend local environment example
# Copy to backend/.env only if you use a dotenv loader locally.
# Never commit backend/.env or any real API key.

FINANCIAL_AI_AUTO_LLM_ENABLED=true
FINANCIAL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
FINANCIAL_LLM_MODEL=gemini-3.6-flash

# Optional Anthropic provider. Use only when
# FINANCIAL_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional OpenAI-compatible provider. Use only when
# FINANCIAL_LLM_PROVIDER=openai_compatible.
FINANCIAL_LLM_ENDPOINT=
FINANCIAL_LLM_API_KEY=
