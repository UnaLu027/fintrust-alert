APP_ENV: "production"
GOOGLE_CLOUD_PROJECT: "fintrust-alert"
DATASTORE_BACKEND: "firestore"
CORS_ALLOW_ORIGINS: "https://fintrust-alert.web.app,https://fintrust-alert.firebaseapp.com"
INGESTION_API_TOKEN: "REPLACE_WITH_RANDOM_TOKEN"
MOPS_XBRL_CACHE_DIR: "/tmp/fintrust/mops_ixbrl_cache"
MOPS_XBRL_CACHE_TTL_HOURS: "24"
FINANCIAL_DATABASE_PATH: "/tmp/fintrust/financial_pipeline.sqlite3"

# Automatic AI layer. Deterministic IC-design analysis runs during refresh;
# this flag controls whether an available LLM is also called in official mode.
FINANCIAL_AI_AUTO_LLM_ENABLED: "true"

# Anthropic Claude provider. Inject ANTHROPIC_API_KEY through Secret Manager
# or another secret mechanism; do not store the real key in this file.
FINANCIAL_LLM_PROVIDER: "anthropic"
FINANCIAL_LLM_MODEL: "claude-sonnet-5"

# Optional OpenAI-compatible provider settings. These are ignored when
# FINANCIAL_LLM_PROVIDER=anthropic.
FINANCIAL_LLM_ENDPOINT: ""
FINANCIAL_LLM_API_KEY: ""
