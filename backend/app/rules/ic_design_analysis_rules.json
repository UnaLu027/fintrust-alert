{
  "version": "ic-design-ai-analysis-0.1.0",
  "subindustry": "IC 設計",
  "description": "多面向 IC 設計基本面分析規則；同時保留直接衡量、間接衡量、交叉條件與趨勢判斷，供 AI 整合與後台監控。",
  "rules": [
    {
      "rule_id": "IC_GROWTH_001",
      "name": "主要成長指標同步成長",
      "dimension": "growth",
      "assessment_type": "direct",
      "severity": "positive",
      "logic_expression": "revenue_growth_yoy > 0 AND operating_income_growth_yoy > 0 AND net_income_growth_yoy > 0",
      "direct_metrics": ["revenue_growth_yoy", "operating_income_growth_yoy", "net_income_growth_yoy"],
      "indirect_metrics": ["eps_growth_yoy"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "gt", "value": 0},
        {"feature": "operating_income_growth_yoy", "op": "gt", "value": 0},
        {"feature": "net_income_growth_yoy", "op": "gt", "value": 0}
      ]},
      "rationale": "營收、營業利益與淨利同步成長，比單看營收更能支持基本面成長。"
    },
    {
      "rule_id": "IC_GROWTH_002",
      "name": "營收成長但獲利成長未跟上",
      "dimension": "growth",
      "assessment_type": "cross_factor",
      "severity": "attention",
      "logic_expression": "revenue_growth_yoy > 0 AND (operating_income_growth_yoy < 0 OR net_income_growth_yoy < 0)",
      "direct_metrics": ["revenue_growth_yoy"],
      "indirect_metrics": ["operating_income_growth_yoy", "net_income_growth_yoy"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "gt", "value": 0},
        {"any": [
          {"feature": "operating_income_growth_yoy", "op": "lt", "value": 0},
          {"feature": "net_income_growth_yoy", "op": "lt", "value": 0}
        ]}
      ]},
      "rationale": "營收增加但核心獲利沒有同步，代表成長品質需要進一步拆解。"
    },
    {
      "rule_id": "IC_GROWTH_003",
      "name": "主要成長指標同步衰退",
      "dimension": "growth",
      "assessment_type": "direct",
      "severity": "high_attention",
      "logic_expression": "revenue_growth_yoy < 0 AND operating_income_growth_yoy < 0 AND net_income_growth_yoy < 0",
      "direct_metrics": ["revenue_growth_yoy", "operating_income_growth_yoy", "net_income_growth_yoy"],
      "indirect_metrics": ["eps_growth_yoy"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "lt", "value": 0},
        {"feature": "operating_income_growth_yoy", "op": "lt", "value": 0},
        {"feature": "net_income_growth_yoy", "op": "lt", "value": 0}
      ]},
      "rationale": "營收與主要獲利指標同步負成長，屬於較全面的基本面收縮訊號。"
    },
    {
      "rule_id": "IC_PROFIT_001",
      "name": "三項獲利率同步改善",
      "dimension": "profitability",
      "assessment_type": "direct",
      "severity": "positive",
      "logic_expression": "gross_margin_change_pp > 0 AND operating_margin_change_pp > 0 AND net_margin_change_pp > 0",
      "direct_metrics": ["gross_margin", "operating_margin", "net_margin"],
      "indirect_metrics": [],
      "condition": {"all": [
        {"feature": "gross_margin_change_pp", "op": "gt", "value": 0},
        {"feature": "operating_margin_change_pp", "op": "gt", "value": 0},
        {"feature": "net_margin_change_pp", "op": "gt", "value": 0}
      ]},
      "rationale": "毛利率、營業利益率與淨利率同步改善，代表獲利能力改善較具一致性。"
    },
    {
      "rule_id": "IC_PROFIT_002",
      "name": "毛利率與營業利益率同步下滑",
      "dimension": "profitability",
      "assessment_type": "trend",
      "severity": "attention",
      "logic_expression": "gross_margin_change_pp <= -1 AND operating_margin_change_pp <= -1",
      "direct_metrics": ["gross_margin", "operating_margin"],
      "indirect_metrics": ["revenue_growth_yoy"],
      "condition": {"all": [
        {"feature": "gross_margin_change_pp", "op": "lte", "value": -1},
        {"feature": "operating_margin_change_pp", "op": "lte", "value": -1}
      ]},
      "rationale": "兩個核心利潤率同時下降，比單一比率波動更值得關注。"
    },
    {
      "rule_id": "IC_PROFIT_003",
      "name": "營收成長伴隨利潤率壓縮",
      "dimension": "profitability",
      "assessment_type": "cross_factor",
      "severity": "attention",
      "logic_expression": "revenue_growth_yoy > 0 AND gross_margin_change_pp < 0 AND operating_margin_change_pp < 0",
      "direct_metrics": ["gross_margin", "operating_margin"],
      "indirect_metrics": ["revenue_growth_yoy"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "gt", "value": 0},
        {"feature": "gross_margin_change_pp", "op": "lt", "value": 0},
        {"feature": "operating_margin_change_pp", "op": "lt", "value": 0}
      ]},
      "rationale": "營收雖成長，但毛利率與營業利益率同步下降，可能反映產品組合、價格或成本壓力。"
    },
    {
      "rule_id": "IC_RD_001",
      "name": "研發投入持續增加且研發強度未下降",
      "dimension": "rd_innovation",
      "assessment_type": "direct",
      "severity": "positive",
      "logic_expression": "rd_expense_growth_yoy > 0 AND rd_intensity_change_pp >= 0",
      "direct_metrics": ["rd_expense_growth_yoy", "rd_intensity"],
      "indirect_metrics": ["revenue_growth_yoy"],
      "condition": {"all": [
        {"feature": "rd_expense_growth_yoy", "op": "gt", "value": 0},
        {"feature": "rd_intensity_change_pp", "op": "gte", "value": 0}
      ]},
      "rationale": "IC 設計高度依賴研發；研發費用增加且占營收比未下降可視為投入持續性的正向觀察。"
    },
    {
      "rule_id": "IC_RD_002",
      "name": "研發強度明顯下降",
      "dimension": "rd_innovation",
      "assessment_type": "trend",
      "severity": "attention",
      "logic_expression": "rd_intensity_change_pp <= -2",
      "direct_metrics": ["rd_intensity"],
      "indirect_metrics": ["revenue_growth_yoy", "gross_margin"],
      "condition": {"feature": "rd_intensity_change_pp", "op": "lte", "value": -2},
      "rationale": "IC 設計競爭力高度依賴持續研發投入；研發強度明顯下降需搭配產品與獲利趨勢觀察。"
    },
    {
      "rule_id": "IC_RD_003",
      "name": "研發投入轉化與產品去化壓力",
      "dimension": "rd_innovation",
      "assessment_type": "cross_factor",
      "severity": "high_attention",
      "logic_expression": "rd_intensity_change_pp >= 0 AND revenue_growth_yoy < 0 AND inventory_revenue_gap >= 15 AND cash_conversion_ratio < 0.8",
      "direct_metrics": ["rd_intensity", "rd_expense_growth_yoy"],
      "indirect_metrics": ["revenue_growth_yoy", "inventory_growth_yoy", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "rd_intensity_change_pp", "op": "gte", "value": 0},
        {"feature": "revenue_growth_yoy", "op": "lt", "value": 0},
        {"feature": "inventory_revenue_gap", "op": "gte", "value": 15},
        {"feature": "cash_conversion_ratio", "op": "lt", "value": 0.8}
      ]},
      "rationale": "研發增加本身不是風險；只有研發維持高投入、營收衰退、存貨去化與現金轉換同時承壓時才提高注意。"
    },
    {
      "rule_id": "IC_OPS_001",
      "name": "存貨增速高於營收",
      "dimension": "operating_efficiency",
      "assessment_type": "indirect",
      "severity": "attention",
      "logic_expression": "inventory_revenue_gap >= 15",
      "direct_metrics": ["inventory_growth_yoy"],
      "indirect_metrics": ["revenue_growth_yoy"],
      "condition": {"feature": "inventory_revenue_gap", "op": "gte", "value": 15},
      "rationale": "存貨增加需與營收共同解讀；增速差距過大可能反映備貨、產品組合或去化壓力。"
    },
    {
      "rule_id": "IC_OPS_002",
      "name": "營收衰退且存貨明顯逆勢增加",
      "dimension": "operating_efficiency",
      "assessment_type": "cross_factor",
      "severity": "high_attention",
      "logic_expression": "revenue_growth_yoy < 0 AND inventory_revenue_gap >= 30",
      "direct_metrics": ["inventory_growth_yoy"],
      "indirect_metrics": ["revenue_growth_yoy", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "lt", "value": 0},
        {"feature": "inventory_revenue_gap", "op": "gte", "value": 30}
      ]},
      "rationale": "需求轉弱期間存貨仍快速增加，較可能形成產品去化與營運資金壓力。"
    },
    {
      "rule_id": "IC_OPS_003",
      "name": "營收成長且存貨增速未明顯超前",
      "dimension": "operating_efficiency",
      "assessment_type": "cross_factor",
      "severity": "positive",
      "logic_expression": "revenue_growth_yoy > 0 AND inventory_revenue_gap <= 5",
      "direct_metrics": ["inventory_growth_yoy"],
      "indirect_metrics": ["revenue_growth_yoy"],
      "condition": {"all": [
        {"feature": "revenue_growth_yoy", "op": "gt", "value": 0},
        {"feature": "inventory_revenue_gap", "op": "lte", "value": 5}
      ]},
      "rationale": "營收擴張時存貨增速沒有大幅超前，可視為產品去化相對平衡的正向觀察。"
    },
    {
      "rule_id": "IC_CASH_001",
      "name": "帳面獲利為正但營業現金流為負",
      "dimension": "cash_flow",
      "assessment_type": "cross_factor",
      "severity": "high_attention",
      "logic_expression": "net_margin > 0 AND operating_cash_flow < 0",
      "direct_metrics": ["operating_cash_flow", "cash_conversion_ratio"],
      "indirect_metrics": ["net_margin"],
      "condition": {"all": [
        {"feature": "net_margin", "op": "gt", "value": 0},
        {"feature": "operating_cash_flow", "op": "lt", "value": 0}
      ]},
      "rationale": "帳面獲利未轉化成營業現金時，需進一步檢視存貨、應收與非現金項目。"
    },
    {
      "rule_id": "IC_CASH_002",
      "name": "現金轉換能力偏弱",
      "dimension": "cash_flow",
      "assessment_type": "direct",
      "severity": "attention",
      "logic_expression": "cash_conversion_ratio < 0.8",
      "direct_metrics": ["cash_conversion_ratio"],
      "indirect_metrics": ["net_income_growth_yoy"],
      "condition": {"feature": "cash_conversion_ratio", "op": "lt", "value": 0.8},
      "rationale": "營業現金流相對淨利偏低，代表盈餘轉化為現金的程度需要觀察。"
    },
    {
      "rule_id": "IC_CASH_003",
      "name": "獲利與現金流同步改善",
      "dimension": "cash_flow",
      "assessment_type": "cross_factor",
      "severity": "positive",
      "logic_expression": "net_income_growth_yoy > 0 AND operating_cash_flow_change_percent > 0 AND cash_conversion_ratio >= 0.8",
      "direct_metrics": ["operating_cash_flow", "cash_conversion_ratio"],
      "indirect_metrics": ["net_income_growth_yoy"],
      "condition": {"all": [
        {"feature": "net_income_growth_yoy", "op": "gt", "value": 0},
        {"feature": "operating_cash_flow_change_percent", "op": "gt", "value": 0},
        {"feature": "cash_conversion_ratio", "op": "gte", "value": 0.8}
      ]},
      "rationale": "淨利與營業現金流同步增長且現金轉換不弱，較能支持獲利品質改善。"
    },
    {
      "rule_id": "IC_STRUCT_001",
      "name": "負債比高且持續上升",
      "dimension": "financial_structure",
      "assessment_type": "cross_factor",
      "severity": "attention",
      "logic_expression": "debt_ratio >= 70 AND debt_ratio_change_pp >= 10",
      "direct_metrics": ["debt_ratio"],
      "indirect_metrics": ["current_ratio", "free_cash_flow"],
      "condition": {"all": [
        {"feature": "debt_ratio", "op": "gte", "value": 70},
        {"feature": "debt_ratio_change_pp", "op": "gte", "value": 10}
      ]},
      "rationale": "負債比需同時觀察絕對水準與歷史變化，避免僅用單一固定門檻判斷。"
    },
    {
      "rule_id": "IC_STRUCT_002",
      "name": "短期流動性惡化",
      "dimension": "financial_structure",
      "assessment_type": "trend",
      "severity": "high_attention",
      "logic_expression": "current_ratio < 100 AND current_ratio_change_pp < 0",
      "direct_metrics": ["current_ratio"],
      "indirect_metrics": ["operating_cash_flow", "free_cash_flow"],
      "condition": {"all": [
        {"feature": "current_ratio", "op": "lt", "value": 100},
        {"feature": "current_ratio_change_pp", "op": "lt", "value": 0}
      ]},
      "rationale": "流動比率低於 100% 且仍下降時，短期償債與營運資金彈性需要優先觀察。"
    },
    {
      "rule_id": "IC_STRUCT_003",
      "name": "財務結構維持充足緩衝",
      "dimension": "financial_structure",
      "assessment_type": "direct",
      "severity": "positive",
      "logic_expression": "debt_ratio < 70 AND current_ratio >= 120 AND free_cash_flow > 0",
      "direct_metrics": ["debt_ratio", "current_ratio"],
      "indirect_metrics": ["free_cash_flow"],
      "condition": {"all": [
        {"feature": "debt_ratio", "op": "lt", "value": 70},
        {"feature": "current_ratio", "op": "gte", "value": 120},
        {"feature": "free_cash_flow", "op": "gt", "value": 0}
      ]},
      "rationale": "負債水準、短期流動性與自由現金流同時具緩衝，較能支持財務結構穩定。"
    },
    {
      "rule_id": "IC_EQ_001",
      "name": "淨利成長但營業現金流下降",
      "dimension": "earnings_quality",
      "assessment_type": "indirect",
      "severity": "attention",
      "logic_expression": "net_income_growth_yoy > 0 AND operating_cash_flow_change_percent < 0",
      "direct_metrics": ["net_income_growth_yoy"],
      "indirect_metrics": ["operating_cash_flow_change_percent", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "net_income_growth_yoy", "op": "gt", "value": 0},
        {"feature": "operating_cash_flow_change_percent", "op": "lt", "value": 0}
      ]},
      "rationale": "淨利增加但營業現金流下降，代表帳面獲利與現金實現程度不同步。"
    },
    {
      "rule_id": "IC_EQ_002",
      "name": "淨利與現金流成長差距過大",
      "dimension": "earnings_quality",
      "assessment_type": "indirect",
      "severity": "high_attention",
      "logic_expression": "profit_cash_growth_gap >= 30 AND cash_conversion_ratio < 0.8",
      "direct_metrics": ["net_income_growth_yoy"],
      "indirect_metrics": ["operating_cash_flow_change_percent", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "profit_cash_growth_gap", "op": "gte", "value": 30},
        {"feature": "cash_conversion_ratio", "op": "lt", "value": 0.8}
      ]},
      "rationale": "淨利成長遠高於營業現金流且現金轉換偏弱時，盈餘品質需要更深入拆解。"
    },
    {
      "rule_id": "IC_EQ_003",
      "name": "獲利成長具現金流支持",
      "dimension": "earnings_quality",
      "assessment_type": "indirect",
      "severity": "positive",
      "logic_expression": "net_income_growth_yoy > 0 AND operating_cash_flow_change_percent > 0 AND cash_conversion_ratio >= 0.8",
      "direct_metrics": ["net_income_growth_yoy"],
      "indirect_metrics": ["operating_cash_flow_change_percent", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "net_income_growth_yoy", "op": "gt", "value": 0},
        {"feature": "operating_cash_flow_change_percent", "op": "gt", "value": 0},
        {"feature": "cash_conversion_ratio", "op": "gte", "value": 0.8}
      ]},
      "rationale": "淨利成長同時獲得營業現金流支持，較能降低只看帳面盈餘的偏誤。"
    },
    {
      "rule_id": "IC_INVEST_001",
      "name": "研發投入與營收同步成長",
      "dimension": "investment_efficiency",
      "assessment_type": "indirect",
      "severity": "positive",
      "logic_expression": "rd_expense_growth_yoy > 0 AND revenue_growth_yoy > 0 AND gross_margin_change_pp >= -1",
      "direct_metrics": ["rd_expense_growth_yoy", "rd_intensity"],
      "indirect_metrics": ["revenue_growth_yoy", "gross_margin"],
      "condition": {"all": [
        {"feature": "rd_expense_growth_yoy", "op": "gt", "value": 0},
        {"feature": "revenue_growth_yoy", "op": "gt", "value": 0},
        {"feature": "gross_margin_change_pp", "op": "gte", "value": -1}
      ]},
      "rationale": "研發投入增加、營收同步成長且毛利率未顯著惡化，可視為投入轉化的初步正向證據。"
    },
    {
      "rule_id": "IC_INVEST_002",
      "name": "研發支出增速遠高於營收且營收衰退",
      "dimension": "investment_efficiency",
      "assessment_type": "cross_factor",
      "severity": "attention",
      "logic_expression": "rd_revenue_growth_gap >= 20 AND revenue_growth_yoy < 0",
      "direct_metrics": ["rd_expense_growth_yoy"],
      "indirect_metrics": ["revenue_growth_yoy", "operating_margin"],
      "condition": {"all": [
        {"feature": "rd_revenue_growth_gap", "op": "gte", "value": 20},
        {"feature": "revenue_growth_yoy", "op": "lt", "value": 0}
      ]},
      "rationale": "研發投入具有遞延效益，不能直接判負面；但投入增速與營收表現落差擴大時需持續追蹤轉化效率。"
    },
    {
      "rule_id": "IC_INVEST_003",
      "name": "研發投入提高但營收、毛利與現金轉換同步承壓",
      "dimension": "investment_efficiency",
      "assessment_type": "cross_factor",
      "severity": "high_attention",
      "logic_expression": "rd_intensity_change_pp >= 2 AND revenue_growth_yoy < 0 AND gross_margin_change_pp <= -3 AND cash_conversion_ratio < 0.8",
      "direct_metrics": ["rd_intensity"],
      "indirect_metrics": ["revenue_growth_yoy", "gross_margin", "cash_conversion_ratio"],
      "condition": {"all": [
        {"feature": "rd_intensity_change_pp", "op": "gte", "value": 2},
        {"feature": "revenue_growth_yoy", "op": "lt", "value": 0},
        {"feature": "gross_margin_change_pp", "op": "lte", "value": -3},
        {"feature": "cash_conversion_ratio", "op": "lt", "value": 0.8}
      ]},
      "rationale": "高研發投入需以營收、毛利與現金轉換間接檢視成果；多項結果同步承壓時提高注意。"
    }
  ]
}
