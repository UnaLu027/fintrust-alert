{
  "name": "fintrust-alert",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "demo:backend": "bash scripts/codespaces-start-backend.sh",
    "demo:official": "bash scripts/codespaces-run-demo.sh 2330 3 2024 official",
    "demo:fixture": "bash scripts/codespaces-run-demo.sh 2330 3 2024 demo_fixture",
    "demo:semiconductor": "cd backend && PYTHONPATH=. .venv/bin/python scripts/smoke_semiconductor_companies.py --years 3 --end-year 2024 --output data/demo-output/phase3-semiconductor-summary.json",
    "demo:semiconductor:strict": "cd backend && PYTHONPATH=. .venv/bin/python scripts/smoke_semiconductor_companies.py --years 3 --end-year 2024 --strict --output data/demo-output/phase3-semiconductor-summary.json",
    "demo:audit": "cd backend && PYTHONPATH=. .venv/bin/python scripts/audit_financial_pipeline.py --ticker 2330",
    "demo:diagnose-mops": "cd backend && PYTHONPATH=. .venv/bin/python scripts/diagnose_mops_mapping.py --ticker 2330 --roc-year 113 --output data/demo-output/mops-mapping-2330-2024.json",
    "firebase:login": "npx firebase-tools login",
    "deploy:hosting": "npm run build && npx firebase-tools deploy --only hosting --project fintrust-alert"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "msw": "^2.14.6",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
